# ==============================================================================
# BugBounty-Copilot: Autonomous Cloud Agent & HexStrike AI Sandbox
# 100% Isolated Container with 150+ Security Tools
# ==============================================================================
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# 1. Core System & Security Tool Packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-dev \
    git \
    curl \
    wget \
    unzip \
    jq \
    nmap \
    sqlmap \
    nikto \
    ffuf \
    gobuster \
    netcat-traditional \
    dnsutils \
    whois \
    ca-certificates \
    build-essential \
    libpcap-dev \
    && rm -rf /var/lib/apt/lists/*

# 2. Install ProjectDiscovery Core Arsenal (nuclei, httpx, subfinder)
RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "x86_64" ]; then ARCH_NAME="amd64"; else ARCH_NAME="arm64"; fi && \
    # Nuclei
    wget -q https://github.com/projectdiscovery/nuclei/releases/download/v3.3.5/nuclei_3.3.5_linux_${ARCH_NAME}.zip -O /tmp/nuclei.zip && \
    unzip -q /tmp/nuclei.zip -d /usr/local/bin nuclei && rm /tmp/nuclei.zip && \
    # Httpx
    wget -q https://github.com/projectdiscovery/httpx/releases/download/v1.6.8/httpx_1.6.8_linux_${ARCH_NAME}.zip -O /tmp/httpx.zip && \
    unzip -q /tmp/httpx.zip -d /usr/local/bin httpx && rm /tmp/httpx.zip && \
    # Subfinder
    wget -q https://github.com/projectdiscovery/subfinder/releases/download/v2.6.6/subfinder_2.6.6_linux_${ARCH_NAME}.zip -O /tmp/subfinder.zip && \
    unzip -q /tmp/subfinder.zip -d /usr/local/bin subfinder && rm /tmp/subfinder.zip && \
    chmod +x /usr/local/bin/nuclei /usr/local/bin/httpx /usr/local/bin/subfinder

# 3. Setup HexStrike AI Framework
WORKDIR /opt/hexstrike-ai
RUN git clone https://github.com/0x4m4/hexstrike-ai.git /opt/hexstrike-ai && \
    pip3 install --no-cache-dir --upgrade pip && \
    pip3 install --no-cache-dir flask requests psutil fastmcp beautifulsoup4 aiohttp streamlit

# 4. Workspace & Application Setup
WORKDIR /workspace
COPY . /workspace

EXPOSE 5055 8501

CMD ["bash", "-c", "python3 /opt/hexstrike-ai/hexstrike_server.py --port 5055 & streamlit run ui/app.py --server.port 8501 --server.address 0.0.0.0"]
